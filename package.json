{
  "name": "roadlife-ai-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Driven GPS-Based Road Lifecycle, Construction Material Visual Verification, Road Damage Detection, Smart Repair Planning and Contractor Performance Management System",
  "workspaces": [
    "frontend",
    "backend-express"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "node scripts/dev.js",
    "dev:backend": "npm --prefix backend-express run dev",
    "backend:dev": "npm --prefix backend-express run dev",
    "backend:start": "npm --prefix backend-express start",
    "dev:frontend": "npm --prefix frontend run dev",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build"
  }
}
