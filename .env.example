# RoadLife AI — Environment Configuration Example
# Copy this file to .env in local development: cp .env.example .env

PROJECT_NAME="RoadLife AI"
ENVIRONMENT=development

# Express Backend Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration (MongoDB)
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/roadlife_db?retryWrites=true&w=majority
# Local Docker: mongodb://localhost:27017/roadlife_db
# (If unset, backend operates in resilient in-memory fallback mode)
MONGO_URI=

# Authentication & Security
JWT_SECRET=roadlife-ai-development-secret-jwt-key-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# AI Computer Vision Microservice (FastAPI + YOLOv8 + PyTorch)
ML_SERVICE_URL=http://localhost:8001
YOLO_OFFLINE=1

# External APIs (Optional)
WEATHER_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
