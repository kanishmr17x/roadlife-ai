# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication & JWT Configuration (Generate a strong random secret in production)
JWT_SECRET=replace_with_strong_random_secret_in_production
JWT_EXPIRES_IN=24h

# Database Configuration (MongoDB Atlas connection string)
MONGO_URI=

# Initial Municipal Administrator Provisioning (Optional env override for provision script)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_DEPT=
