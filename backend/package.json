{
  "name": "roadlife-ai-backend-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "Bridge scripts pointing to backend-express and Python FastAPI backend",
  "scripts": {
    "dev": "npm --prefix ../backend-express run dev",
    "start": "npm --prefix ../backend-express start",
    "dev:express": "npm --prefix ../backend-express run dev",
    "dev:python": "uvicorn app.main:app --reload --port 8000"
  }
}
